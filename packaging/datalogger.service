# System unit installed by the .deb/.rpm packages; runs as the datalogger user that
# preinstall.sh creates.
[Unit]
Description=Datalogger
Documentation=https://github.com/dombyte/datalogger#readme
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=datalogger
Group=datalogger
# The status socket is in the RuntimeDirectory: /tmp is private (PrivateTmp). Check with
#   sudo -u datalogger datalogger -status -status-socket /run/datalogger/datalogger.sock
ExecStart=/usr/bin/datalogger -config /etc/datalogger/config.yaml \
    -status-socket /run/datalogger/datalogger.sock
RuntimeDirectory=datalogger
RuntimeDirectoryMode=0750
# Relative paths in the config (./data/data.csv) land in /var/lib/datalogger, the only
# directory the service may write to.
StateDirectory=datalogger
StateDirectoryMode=0750
WorkingDirectory=/var/lib/datalogger
# Exit 1 = a component stopped or a file or port could not be opened: start again,
# like the container's restart policy. Exit 2 = the config can never run: restarting
# every 5 s would only repeat the error; fix the config and start the service.
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=2
# datalogger exits within its 8 s hard deadline.
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal

# Hardening. No PrivateDevices: Modbus RTU needs /dev/tty* (group dialout).
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
