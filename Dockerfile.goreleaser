# Built by goreleaser: the binary is prebuilt and copied into the build context.
# ca-certificates and zoneinfo are arch-independent: this stage runs natively on the
# build host, so no step here needs QEMU (release.yml still sets it up, as goreleaser requires).
FROM --platform=$BUILDPLATFORM alpine:3.24.2 AS builder
RUN apk --no-cache add ca-certificates tzdata

FROM scratch
WORKDIR /app
ARG TARGETPLATFORM
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY $TARGETPLATFORM/datalogger /app
ENTRYPOINT ["/app/datalogger"]
