{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "docker-compose",
    "github-actions"
  ],
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enableVulnerabilityAlertsWithLabel('security')",
    ":preserveSemverRanges",
    ":rebaseStalePrs",
    "group:recommended",
    ":semanticCommits"
  ],
  "labels": [
    "renovate"
  ],
  "ignoreUnstable": true,
  "timezone": "Europe/Berlin",
  "minimumReleaseAge": "3 days",
  "automergeType": "pr",
  "automergeStrategy": "merge-commit",
  "platformAutomerge": false,
  "automergeSchedule": [
    "* 0-5 * * *"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go dependencies",
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Docker images"
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "groupName": "Docker Compose"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Non-major updates merge by themselves once the required checks pass, only within automergeSchedule",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Go module majors change the module path and need code changes; update by hand",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "golangci-lint majors need a .golangci.yml migration; update by hand",
      "matchPackageNames": [
        "golangci/golangci-lint"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "The example compose file uses our own image at :latest on purpose",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "ghcr.io/dombyte/datalogger"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "separateMinorPatch": true,
  "stopUpdatingLabel": "renovate/stop_updating"
}
