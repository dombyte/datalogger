{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "custom.regex"
  ],
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enableVulnerabilityAlertsWithLabel('security')",
    ":preserveSemverRanges",
    ":rebaseStalePrs",
    "group:recommended",
    ":semanticCommits"
  ],
  "labels": [
    "renovate"
  ],
  "ignoreUnstable": true,
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "Go tools"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Docker images"
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "groupName": "Docker Compose"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Go module majors change the module path and need code changes; update by hand",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "golangci-lint majors need a .golangci.yml migration; update by hand",
      "matchPackageNames": [
        "golangci/golangci-lint"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "The example compose file uses our own image at :latest on purpose",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "ghcr.io/dombyte/datalogger"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "separateMinorPatch": true,
  "stopUpdatingLabel": "renovate/stop_updating",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned `go run <module>@<version>` tools (mockery, deadcode, govulncheck) in CI, the pre-commit script and docs",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^scripts/.+\\.sh$/",
        "/^AGENTS\\.md$/",
        "/^\\.mockery\\.yaml$/"
      ],
      "matchStrings": [
        "go run (?<packageName>(?:golang\\.org/x|github\\.com/[^/\\s]+)/[^/@\\s]+(?:/v\\d+)?)(?:/[^@\\s]*)?@(?<currentValue>v[^\\s]+)"
      ],
      "depNameTemplate": "{{{packageName}}}",
      "datasourceTemplate": "go"
    }
  ]
}
